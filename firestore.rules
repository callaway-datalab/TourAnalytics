rules_version = '2';

// ============================================================================
// Client Portal — Firestore security rules
//
// There is no server in this app: the browser talks to Firestore directly.
// These rules ARE the access control. Read them before you trust the app.
//
// SETUP: replace the UID below with your admin account's UID (Firebase Console
// -> Authentication -> your user -> "User UID"), then paste this whole file
// into Firestore Database -> Rules and click Publish. No install needed.
//
// Design notes, so future edits don't reopen a hole:
//  - `allow list` must depend on `resource.data` (or on a path segment that is
//    fixed for the whole collection being listed) so Firestore can prove every
//    possible result satisfies the rule. A list rule that only checks
//    `request.auth` (with no reference to resource/path) allows listing the
//    ENTIRE collection, not just "your own" — this file was fixed once for
//    exactly that mistake on `threads`; don't reintroduce it.
//  - Every `update` rule restricts which fields may change, using
//    `affectedKeys().hasOnly([...])`, so a client can't smuggle in an extra
//    field change alongside a legitimate one.
// ============================================================================

service cloud.firestore {
  match /databases/{db}/documents {

    // vvv  REPLACE THIS with your admin account's UID  vvv
    function adminUids() {
      return ['gpz41RIE02U2Jxteu8H6AGCUjCx1'];
    }
    // ^^^ You can list more than one: ['uid1', 'uid2']

    function isSignedIn() { return request.auth != null; }
    function isAdmin() { return isSignedIn() && request.auth.uid in adminUids(); }

    // The clientKey on the caller's own user profile, or null. One extra
    // document read per rule check; Firestore does not charge for reads
    // performed while evaluating security rules.
    function myClientKey() {
      return isSignedIn()
        ? get(/databases/$(db)/documents/users/$(request.auth.uid)).data.clientKey
        : null;
    }
    function isOwnClient(clientKey) { return isSignedIn() && myClientKey() == clientKey; }
    function changedOnly(fields) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields); }

    // ------------------------------------------------------------------ //
    // Invite codes. Doc ID is the code itself (high-entropy, unguessable),
    // so a plain `get` by ID acts like a password: only someone who already
    // has the code can read it. `list` is admin-only so nobody can browse
    // the collection looking for unused codes.
    // ------------------------------------------------------------------ //
    match /invites/{code} {
      allow get: if true;
      allow list: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(
             ['clientKey', 'clientLabel', 'note', 'createdAt', 'expiresAt', 'usedBy', 'usedAt', 'revoked'])
        && request.resource.data.clientKey is string && request.resource.data.clientKey.size() > 0
        && request.resource.data.usedBy == null
        && request.resource.data.revoked == false;

      // Claiming a code during sign-up: a brand new account may mark exactly
      // one still-open, non-revoked, non-expired invite as used by itself,
      // touching only usedBy/usedAt and nothing else about the invite.
      allow update: if isAdmin()
        || (isSignedIn()
            && resource.data.usedBy == null
            && resource.data.revoked == false
            && (resource.data.expiresAt == null || resource.data.expiresAt > request.time)
            && changedOnly(['usedBy', 'usedAt'])
            && request.resource.data.usedBy == request.auth.uid
            && request.resource.data.usedAt == request.time);
      allow delete: if false; // revoke instead, so the audit trail stays intact
    }

    // ------------------------------------------------------------------ //
    // User profiles. A user creates their own profile once, at sign-up,
    // and the clientKey it carries must come from the invite they claimed
    // in the same batch — the client cannot invent a clientKey.
    // ------------------------------------------------------------------ //
    match /users/{uid} {
      allow get: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['email', 'name', 'clientKey', 'clientLabel', 'inviteCode', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.clientKey ==
             get(/databases/$(db)/documents/invites/$(request.resource.data.inviteCode)).data.clientKey;
      allow update: if isSignedIn() && request.auth.uid == uid && changedOnly(['name']);
      allow delete: if isAdmin(); // removes their access to client data; see README for the Auth-account caveat
    }

    // ------------------------------------------------------------------ //
    // Per-client data. Storage path IS the security boundary: everything
    // under clientData/{clientKey}/... belongs to that one client. Chunk
    // docs are fetched by known sequential ID ("0","1",...), never listed,
    // so only `get` needs to be considered for them.
    // ------------------------------------------------------------------ //
    match /clientData/{clientKey}/datasets/{datasetId} {
      allow read: if isAdmin() || isOwnClient(clientKey);
      allow write: if isAdmin();

      match /chunks/{chunkId} {
        allow get: if isAdmin() || isOwnClient(clientKey);
        allow write: if isAdmin();
      }
    }

    // Dataset catalogue the admin manages (one record per upload, tracks
    // which clientKeys it was split into, for clean deletes/replacements).
    // Not client-readable; clientData above is what clients see.
    match /datasets/{datasetId} {
      allow read, write: if isAdmin();
    }

    // ------------------------------------------------------------------ //
    // Documents (PDF/PPTX) library. Stored as base64 chunks because Cloud
    // Storage now requires a billing account even for tiny files; Firestore
    // does not. `audienceClientKey: null` means visible to every client.
    // ------------------------------------------------------------------ //
    match /documents/{docId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.audienceClientKey == null || isOwnClient(resource.data.audienceClientKey)));
      allow write: if isAdmin();

      // Chunk docs are fetched by known sequential ID, never listed, so this
      // only needs to cover `get`. docId is fixed for the whole subcollection
      // (it's a path segment here, not a queried field), so this is decidable.
      match /chunks/{chunkId} {
        function doc() { return get(/databases/$(db)/documents/documents/$(docId)).data; }
        allow get: if isAdmin() || (isSignedIn() && (doc().audienceClientKey == null || isOwnClient(doc().audienceClientKey)));
        allow write: if isAdmin();
      }
    }

    // ------------------------------------------------------------------ //
    // Questions. A client can create a thread for themselves and read/list
    // only their own (the app always queries with where uid == self, which
    // is what makes the `list` rule below decidable); the admin can read,
    // list and reply to all of them.
    // ------------------------------------------------------------------ //
    match /threads/{threadId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.clientKey == myClientKey()
        && request.resource.data.adminUnread == true
        && request.resource.data.userUnread == false
        && request.resource.data.lastFromAdmin == false;
      allow update: if isAdmin() && changedOnly(['adminUnread', 'userUnread', 'updatedAt', 'lastFromAdmin'])
        || (isSignedIn() && resource.data.uid == request.auth.uid && (
              // sending a follow-up message: flag it unread for the admin
              (changedOnly(['adminUnread', 'userUnread', 'updatedAt', 'lastFromAdmin'])
                && request.resource.data.adminUnread == true && request.resource.data.userUnread == false
                && request.resource.data.lastFromAdmin == false)
              // opening the thread to read the admin's reply
              || (changedOnly(['userUnread']) && request.resource.data.userUnread == false)
            ));
      allow delete: if false;

      match /messages/{messageId} {
        function thread() { return get(/databases/$(db)/documents/threads/$(threadId)).data; }
        allow read: if isAdmin() || (isSignedIn() && thread().uid == request.auth.uid);
        allow create: if isAdmin() && request.resource.data.fromAdmin == true
          || (isSignedIn() && thread().uid == request.auth.uid
              && request.resource.data.fromAdmin == false
              && request.resource.data.authorUid == request.auth.uid);
        allow update, delete: if false; // messages are permanent once sent
      }
    }

    // Nothing else is readable or writable.
    match /{document=**} { allow read, write: if false; }
  }
}
